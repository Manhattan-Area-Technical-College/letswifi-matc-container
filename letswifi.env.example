# letswifi.env.example — copy to /etc/sysconfig/letswifi and fill in your values.
#
# letswifi.container loads this file via EnvironmentFile=/etc/sysconfig/letswifi.
# Sensitive values (SSP_SECRET_SALT, SSP_ADMIN_PASSWORD) should use
# Podman secrets instead of this file on production systems:
#   podman secret create ssp_secret_salt - <<< "your-salt"
#   podman secret create ssp_admin_password - <<< "your-password"
# Leave those lines commented out here if you use secrets.

# ── Required ──────────────────────────────────────────────────────────────────

# Public hostname of this service — used as the Apache ServerName and in
# generated EAP profiles. Must match your TLS certificate's CN/SAN.
LETSWIFI_FQDN=wifi.example.edu

# ── Required (use Podman secrets in production instead) ───────────────────────

# SimpleSAMLphp secret salt — used to sign cookies and tokens.
# Generate with: tr -dc 'A-Za-z0-9' </dev/urandom | head -c64
#SSP_SECRET_SALT=change-me-generate-a-random-string

# SimpleSAMLphp admin password — protects the /simplesaml/admin panel.
# Disable remote admin access in config.php after initial setup.
#SSP_ADMIN_PASSWORD=change-me

# ── Realm provisioning (optional — auto-creates realm + CA on first run) ─────
#
# Set LETSWIFI_REALM to your institution's realm (the part after @ in user IDs,
# e.g. manhattan.edu).  On first start the entrypoint generates a dedicated
# signing CA (P-384, pathlen:0) and writes the realm config automatically.
#
# LETSWIFI_REALM is permanent — it is baked into every device cert issued.
# Changing it after first start invalidates all existing device certificates.
#
# All other values below are only written on first run.  To apply changes after
# initial provisioning, delete /etc/letswifi/realms/<realm>.conf.php and restart.
#
# Before first start, drop your RADIUS server's CA cert PEM(s) into
# /etc/letswifi/trust/ in the config volume.  The container will refuse to
# start without them — they are baked into the EAP profile sent to devices.
# Quick export via RADSEC (run from the deployment host):
#   openssl s_client -showcerts -connect radius1.example.edu:2083 </dev/null 2>/dev/null \
#     | awk '/BEGIN CERTIFICATE/,/END CERTIFICATE/' \
#     > /path/to/letswifi-config-volume/trust/radius-chain.pem
# Multiple CAs (e.g. during a root CA transition): drop multiple .pem files.
# All of them are included in the trust array in the issued EAP profiles.
#
# LETSWIFI_RADIUS_CN is the CN/SAN on your RADIUS server's TLS certificate.
# Devices pin against this name during 802.1x authentication to verify they
# are talking to the correct RADIUS server.
#LETSWIFI_REALM=manhattan.edu
#LETSWIFI_REALM_DISPLAY_NAME="Manhattan Tech Wi-Fi"   # quote values that contain spaces
#LETSWIFI_RADIUS_CN=radius.manhattan.edu
# Multiple RADIUS servers: comma-separated, one entry per server cert CN/SAN.
# Each server needs its own cert but they can all share the same root CA.
#LETSWIFI_RADIUS_CN=radius1.manhattan.edu,radius2.manhattan.edu
#LETSWIFI_REALM_VALIDITY=730        # 2 years — renewal requires full IdP re-auth so match your enrollment period
#LETSWIFI_REALM_CONTACT=noc@manhattan.edu             # quote if it contains spaces
#
# Validity of the signing CA in years.  The CA signs device certificates only;
# it is not part of your institution's PKI hierarchy and should not be trusted
# by anything other than your RADIUS server.
# Default: 15 years.  The upstream default of 50 years is intentionally not
# used here — 15 years provides a more defensible window as quantum-resistant
# algorithms mature, while still outlasting typical device fleet lifecycles.
#LETSWIFI_REALM_CA_VALIDITY=15

# ── Admin access (optional) ──────────────────────────────────────────────────
#
# Comma-separated list of user IDs or eduPersonAffiliation values that grant
# access to the letswifi admin panel (https://<fqdn>/admin).
#
# Each entry is compared against both the authenticated user's username AND
# the eduPersonAffiliation values in their SAML assertion — if any match, the
# user gets admin access.
#
# Use a specific UPN to grant a named person:
#   LETSWIFI_ADMIN_USERS=bryannamarihugh@manhattan.edu
#
# Use an affiliation value to grant a whole role — your IdP must send that value
# as eduPersonAffiliation in the SAML assertion:
#   LETSWIFI_ADMIN_USERS=staff
#
# Mix both:
#   LETSWIFI_ADMIN_USERS=bryannamarihugh@manhattan.edu,it-staff
#
# Only applied on first run. To change after initial provisioning, delete
# /etc/letswifi/letswifi.conf.php and restart (the DB is not affected).
#LETSWIFI_ADMIN_USERS=bryannamarihugh@manhattan.edu

# Attribute from the SAML/OIDC assertion to use as the user identity in device
# certs and RADIUS logs.  Unset = SSP NameID (for Entra this is usually the UPN).
#
# Change this if you want a more stable or privacy-preserving identifier:
#   employeeId        — Entra Employee ID (immutable, survives name/UPN changes)
#   oid               — Entra object GUID (immutable, opaque)
#   eduPersonUniqueId — federated persistent identifier (InCommon)
#
# PERMANENT — baked into every issued device cert.  Changing this after first
# start invalidates all existing certs; every device must re-enroll.
# The attribute must be present in every user's assertion or enrollment fails.
# NPS deployments: leave unset — NPS requires UPN to resolve the AD account.
#LETSWIFI_USER_ID_ATTRIBUTE=employeeId

# Attribute from the SAML/OIDC assertion that carries the user's affiliations.
# Used for realm assignment and admin scope checks (see LETSWIFI_ADMIN_USERS).
# Unset = eduPersonAffiliation (standard InCommon/eduroam attribute).
# Change if your IdP sends affiliations under a different name — for example,
# some Entra OIDC configurations use 'roles' or a custom extension attribute.
# Only applied on first run.
#LETSWIFI_AFFILIATION_ATTRIBUTE=eduPersonAffiliation

# How many days a portal login grant stays valid before the user must
# re-authenticate to enroll additional devices.  Unset = 180 days (upstream default).
# For a 2-year college: set to 730 so a student can add devices throughout their
# enrollment without returning to the portal for a new login.
# This does NOT affect device cert validity (LETSWIFI_REALM_VALIDITY).
# Only applied on first run.
#LETSWIFI_GRANT_TOKEN_VALIDITY=730

# ── Branding (optional) ───────────────────────────────────────────────────────

# Display name shown in the portal UI and in EAP profiles sent to devices.
#LETSWIFI_PRODUCT_NAME=Manhattan Tech Wi-Fi

# Short slug used as the asset directory name — no spaces, lowercase.
# Defaults to a slugified version of LETSWIFI_PRODUCT_NAME if not set.
#LETSWIFI_PRODUCT_SHORTNAME=manhattantech

# Name of the Wi-Fi network. Defaults to "eduroam" if not set.
#LETSWIFI_NETWORK_NAME=eduroam

# To add a custom logo and stylesheet, place files in the letswifi-config volume:
#   /etc/letswifi/branding/custom.css
#   /etc/letswifi/branding/custom.ico   (or .svg / .png)
# entrypoint.sh detects these automatically and links them into the portal on
# every container start — update the files and restart to apply changes.
# LETSWIFI_PRODUCT_SHORTNAME is used as the branding directory name in the URL.

# ── TLS (optional — leave unset to run HTTP behind a reverse proxy) ───────────

# To terminate TLS inside the container, place your cert and key at:
#   /etc/pki/tls/certs/letswifi.crt
#   /etc/pki/tls/private/letswifi.key
# entrypoint.sh enables the HTTPS vhost automatically when both are present.
# Change PublishPort to 8443:443 in letswifi.container when using this.
#
# To also enable mTLS (clients must present a certificate), add:
#   /etc/pki/tls/certs/ca.crt
# mTLS is enabled automatically when that file is present — no variable needed.

# ── Crypto policy (optional) ──────────────────────────────────────────────────

# Overrides the UBI 10 system crypto policy for this container.
# Unset = DEFAULT (TLS 1.2+, strong ciphers — safe starting point)
# FUTURE = TLS 1.3 only, stricter key sizes (set this once all clients support it)
# FIPS   = FIPS 140 algorithms only (also requires fips=1 on the host kernel)
#CRYPTO_POLICY=FUTURE

# ── Federation metadata (optional) ────────────────────────────────────────────

# URL of your IdP or federation MDQ endpoint. When set, entrypoint.sh
# configures SimpleSAMLphp's metarefresh module to pull metadata daily at 04:00.
#SSP_IDP_METADATA_URL=https://mdq.incommon.org/entities

# ── Provider & SSO (optional) ─────────────────────────────────────────────────
#
# The "provider" is what the portal advertises — the institution shown to users
# and which realm + IdP it enrolls against. On first run the entrypoint generates
# /etc/letswifi/provider.conf.php from the vars below (reusing LETSWIFI_REALM,
# LETSWIFI_REALM_CONTACT, LETSWIFI_ADMIN_USERS, LETSWIFI_USER_ID_ATTRIBUTE,
# LETSWIFI_AFFILIATION_ATTRIBUTE and LETSWIFI_GRANT_TOKEN_VALIDITY) and points
# letswifi.conf.php at it via 'provider#inc'. It is only generated when
# LETSWIFI_REALM is set.
#
# Regenerable: delete /etc/letswifi/provider.conf.php and restart to re-apply any
# of those vars — the same delete-and-restart workflow as the realm config.

# Display name of the provider/institution shown in the portal.
# Defaults to LETSWIFI_PRODUCT_NAME, then LETSWIFI_REALM_DISPLAY_NAME, then LETSWIFI_REALM.
#LETSWIFI_PROVIDER_DISPLAY_NAME=Manhattan Area Technical College

# SAML IdP entity ID the provider authenticates against. For Microsoft Entra
# this is https://sts.windows.net/<tenant-id>/ (note the trailing slash).
# When set it populates the provider's samlIdp + idpList, which also skips the
# SimpleSAMLphp IdP-picker screen. Leave unset for a generic / no-pin setup.
#
# This var also drives the SimpleSAMLphp side: the entrypoint seeds a 'default-sp'
# authsource (config/authsources.php) with SP entityID https://<LETSWIFI_FQDN> and
# 'idp' set to this value. For login to work end-to-end you must ALSO:
#   - register that SP entityID at your IdP, with the ACS (reply) URL
#       https://<LETSWIFI_FQDN>/simplesaml/module.php/saml/sp/saml2-acs.php/default-sp
#   - make the IdP metadata available to SSP (set SSP_IDP_METADATA_URL above).
# Regenerable: delete /etc/simplesamlphp/authsources.php and restart to re-apply.
#LETSWIFI_SAML_IDP_ENTITYID=https://sts.windows.net/21e8bc52-a9f4-4adc-8133-b5f395a5ced1/
