# letswifi.env.example — copy to /etc/sysconfig/letswifi and fill in your values.
# Quadlet loads it via EnvironmentFile=; Compose via env_file:. See install.md.
#
# PERMANENT  baked into the CA/certs at first run — set before first start; can't
#            change later without invalidating already-issued certs.
# FIRST RUN  read once at provisioning; re-apply by deleting the noted file under
#            /etc/letswifi (or /etc/simplesamlphp) and restarting.
# LIVE       re-read on every start.


# ── FIRST RUN · PERMANENT — cert & CA (set correctly before first start) ───────

# Triggers first-run CA + realm generation. Put your RADIUS CA cert PEM(s) in
# /etc/letswifi/trust/ first, or the container refuses to start.
#LETSWIFI_REALM=manhattan.edu

# Assertion attribute used as the cert/log identity. 
# LetsWifi generates random names for the cert, so while this won't be exposed make sure this is directory information for FERPA for US people
#LETSWIFI_USER_ID_ATTRIBUTE=employeeId

# Signing CA validity in years. Default 15. Signs device certs only.
#LETSWIFI_REALM_CA_VALIDITY=15

# CRL: default true bakes a crlDistributionPoints (https://<FQDN>/crl/ca.crl) into
# the CA and refreshes it every 6h. False if your RADIUS server ignores CRLs.
#LETSWIFI_ENABLE_CRL=false


# ── FIRST RUN — secrets (re-apply: delete /etc/simplesamlphp/config.php) ───────

# Prefer Podman secrets in production:
#   podman secret create ssp_secret_salt - <<< "$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c64)"
#SSP_SECRET_SALT=change-me-generate-a-random-string
#SSP_ADMIN_PASSWORD=change-me


# ── FIRST RUN — realm (re-apply: delete realms/<realm>.conf.php) ───────────────

# CN/SAN on your RADIUS server cert(s); devices pin against it. Comma-separate
# for multiple servers.
#LETSWIFI_RADIUS_CN=radius.manhattan.edu
#LETSWIFI_REALM_DISPLAY_NAME="Manhattan Tech Wi-Fi"
# Realm description on the admin page. Unset = "Wi-Fi enrollment for <display name>".
#LETSWIFI_REALM_DESCRIPTION="Wi-Fi enrollment for Manhattan Tech"
# Helpdesk address shown in the apps and EAP profiles.
#LETSWIFI_REALM_CONTACT=noc@manhattan.edu

# Device cert validity in days. Default 365. Renewal needs full IdP re-auth.
#LETSWIFI_REALM_VALIDITY=730


# ── FIRST RUN — provider & SSO (re-apply: delete provider.conf.php) ────────────

# Admin panel (/admin) access: comma-separated user IDs and/or affiliations.
#LETSWIFI_ADMIN_USERS=bryannamarihugh@manhattan.edu,it-staff

# Assertion attribute carrying affiliations (realm + admin matching).
# Unset = eduPersonAffiliation.
#LETSWIFI_AFFILIATION_ATTRIBUTE=eduPersonAffiliation

# Portal login grant validity in days (device-enrollment window). Unset = 180.
#LETSWIFI_GRANT_TOKEN_VALIDITY=730

# Provider name in the portal. Defaults to PRODUCT_NAME → REALM_DISPLAY_NAME → REALM.
#LETSWIFI_PROVIDER_DISPLAY_NAME=Manhattan Area Technical College
#LETSWIFI_SAML_IDP_ENTITYID=https://sts.windows.net/<tenant-id>/

# IdP/federation MDQ endpoint; SSP then refreshes metadata at boot + daily 04:00.
#SSP_IDP_METADATA_URL=https://mdq.incommon.org/entities


# ── FIRST RUN — branding (re-apply: delete branding.conf.php) ─────────────────

# Name shown in the portal and EAP profiles.
#LETSWIFI_PRODUCT_NAME=Eduroam Wi-Fi
# Asset dir slug (lowercase, no spaces). Defaults to a slug of PRODUCT_NAME.
#LETSWIFI_PRODUCT_SHORTNAME=manhattantech
# Wi-Fi SSID.
#LETSWIFI_NETWORK_NAME=eduroam


# ── LIVE — re-read on every start ─────────────────────────────────────────────

# Public hostname (Apache ServerName + EAP profiles); must match your TLS cert.
LETSWIFI_FQDN=wifi.example.edu

# Crypto policy. Unset = DEFAULT (TLS 1.2+). FUTURE = TLS 1.3 only.
#CRYPTO_POLICY=FUTURE

# TLS is file-based (no vars): put cert+key at /etc/pki/tls/certs/letswifi.crt and
# /etc/pki/tls/private/letswifi.key to enable HTTPS (use PublishPort 8443:443); add
# /etc/pki/tls/certs/ca.crt to also require client certs. Unset = HTTP behind a proxy.
# Branding is file-based: drop custom.css + custom.ico into /etc/letswifi/branding/.
