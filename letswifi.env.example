# letswifi.env.example — copy to /etc/sysconfig/letswifi and fill in your values.
# Loaded by letswifi.container via EnvironmentFile= (Compose: use env_file:).
# See the install guide for full setup details and the IdP-side steps.
#
# Variables are grouped by when they take effect:
#   FIRST RUN  read once when the container provisions itself. To change later,
#              delete the noted file under /etc/letswifi (or /etc/simplesamlphp)
#              and restart — the database is never touched.
#   LIVE       re-read on every start. Edit the value (or swap the file) and
#              restart; nothing to delete.
# PERMANENT marks first-run values baked into the CA or device certs: changing
# them invalidates already-issued certs, so set them correctly before first start.


# ══════════════════════════════════════════════════════════════════════════════
# FIRST RUN — required secrets   (re-apply: delete /etc/simplesamlphp/config.php)
# ══════════════════════════════════════════════════════════════════════════════

# SimpleSAMLphp secrets. Prefer Podman secrets in production:
#   podman secret create ssp_secret_salt - <<< "$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c64)"
#   podman secret create ssp_admin_password - <<< "your-password"
#SSP_SECRET_SALT=change-me-generate-a-random-string
#SSP_ADMIN_PASSWORD=change-me


# ══════════════════════════════════════════════════════════════════════════════
# FIRST RUN — realm & signing CA   (re-apply: delete realms/<realm>.conf.php)
# ══════════════════════════════════════════════════════════════════════════════
#
# Setting LETSWIFI_REALM triggers first-run generation of the signing CA and the
# realm config. Drop your RADIUS server's CA cert PEM(s) into /etc/letswifi/trust/
# first — the container refuses to start without them.

# PERMANENT — baked into every device cert; changing it invalidates all of them.
#LETSWIFI_REALM=manhattan.edu

# CN/SAN on your RADIUS server's TLS cert (devices pin against this).
# Multiple servers: comma-separated, one entry per server cert.
#LETSWIFI_RADIUS_CN=radius.manhattan.edu
#LETSWIFI_RADIUS_CN=radius1.manhattan.edu,radius2.manhattan.edu

#LETSWIFI_REALM_DISPLAY_NAME="Manhattan Tech Wi-Fi"   # quote values with spaces
#LETSWIFI_REALM_CONTACT=noc@manhattan.edu

# Device cert validity in days. Default 365. Match your enrollment period;
# renewal requires full IdP re-auth.
#LETSWIFI_REALM_VALIDITY=730

# PERMANENT — signing CA validity in years. Default 15 (upstream's 50 is not
# used). The CA signs device certs only — not part of your institution's PKI.
#LETSWIFI_REALM_CA_VALIDITY=15

# CRL publishing. Default true: the CA gets a crlDistributionPoints extension
# (https://<FQDN>/crl/ca.crl) and a timer refreshes the CRL every 6 hours.
# Set false if your RADIUS server doesn't consult a CRL.
# PERMANENT (the CDP) — baked into the CA at first run. The refresh timer itself
# is LIVE (follows this value every start), but the CDP can't be changed later.
#LETSWIFI_ENABLE_CRL=false


# ══════════════════════════════════════════════════════════════════════════════
# FIRST RUN — provider, identity & SSO   (re-apply: delete provider.conf.php)
# ══════════════════════════════════════════════════════════════════════════════

# Admin panel access (https://<fqdn>/admin). Comma-separated user IDs and/or
# eduPersonAffiliation values; each is matched against the user's ID and
# affiliations at login.
#LETSWIFI_ADMIN_USERS=bryannamarihugh@manhattan.edu,it-staff

# PERMANENT — assertion attribute used as the cert/log identity. Unset = SSP
# NameID (UPN on Entra).
#LETSWIFI_USER_ID_ATTRIBUTE=employeeId

# Days a portal login grant stays valid for enrolling more devices.
# Unset = 180. Does not affect device cert validity.
#LETSWIFI_GRANT_TOKEN_VALIDITY=730

# Provider display name shown in the portal.
# Defaults to PRODUCT_NAME → REALM_DISPLAY_NAME → REALM.
#LETSWIFI_PROVIDER_DISPLAY_NAME=Manhattan Area Technical College

#LETSWIFI_SAML_IDP_ENTITYID=https://sts.windows.net/<tenant-id>/

# IdP / federation MDQ endpoint. When set, SSP refreshes metadata daily at 04:00.
# Re-apply: delete /etc/simplesamlphp/config.php.
#SSP_IDP_METADATA_URL=https://mdq.incommon.org/entities


# ══════════════════════════════════════════════════════════════════════════════
# FIRST RUN — branding   (re-apply: delete branding.conf.php)
# ══════════════════════════════════════════════════════════════════════════════

# Display name shown in the portal and EAP profiles.
#LETSWIFI_PRODUCT_NAME=Eduroam Wi-Fi

# Asset directory slug — lowercase, no spaces. Defaults to a slug of PRODUCT_NAME.
#LETSWIFI_PRODUCT_SHORTNAME=manhattantech

# Wi-Fi network name. Default "eduroam".
#LETSWIFI_NETWORK_NAME=eduroam


# ══════════════════════════════════════════════════════════════════════════════
# LIVE — re-read on every start (just restart to apply)
# ══════════════════════════════════════════════════════════════════════════════

# Public hostname — Apache ServerName + EAP profiles. Must match your TLS cert.
# Required at every start.
LETSWIFI_FQDN=wifi.example.edu

# UBI 10 system crypto policy. Unset = DEFAULT (TLS 1.2+). FUTURE = TLS 1.3 only.
# https://docs.redhat.com/en/documentation/red_hat_enterprise_linux/10/html/security_hardening/using-system-wide-cryptographic-policies
#CRYPTO_POLICY=FUTURE

# TLS (file-based, no variable): place cert + key at /etc/pki/tls/certs/letswifi.crt
# and /etc/pki/tls/private/letswifi.key to enable HTTPS (set PublishPort 8443:443
# in letswifi.container). Add /etc/pki/tls/certs/ca.crt to also require client
# certs (mTLS). Leave all unset to run HTTP behind a reverse proxy.

# Custom logo/CSS (file-based): drop custom.css and custom.ico (or .svg/.png)
# into /etc/letswifi/branding/ — picked up on every restart.
